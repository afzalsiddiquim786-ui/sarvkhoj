{
  "name": "sarvkhoj",
  "productName": "SarvKhoj",
  "version": "1.0.0",
  "description": "SarvKhoj (सर्वखोज) — search any PDF, image, Word, Excel, PowerPoint or text file. Hindi + English, offline and private.",
  "homepage": "https://github.com/",
  "author": {
    "name": "SarvKhoj",
    "email": "sarvkhoj@example.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "start": "npm run prepare:web && electron .",
    "dist:win": "npm run prepare:web && electron-builder --win --publish never",
    "dist:mac": "npm run prepare:web && electron-builder --mac --publish never",
    "dist:linux": "npm run prepare:web && electron-builder --linux --publish never",
    "android:apk": "npm run prepare:web && node scripts/android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jszip": "^3.10.1",
    "pako": "^2.1.0",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "^5.0.0",
    "tesseract.js-core": "^5.0.0",
    "utif": "*",
    "xlsx": "0.18.5",
    "onnxruntime-web": "1.20.1"
  },
  "build": {
    "appId": "in.sarvkhoj.app",
    "productName": "SarvKhoj",
    "copyright": "SarvKhoj",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json",
      "!**/node_modules/@capacitor/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SarvKhoj",
      "artifactName": "SarvKhoj-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SarvKhoj-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "SarvKhoj-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office",
      "synopsis": "Search any document — Hindi + English, offline",
      "maintainer": "SarvKhoj <sarvkhoj@example.com>",
      "artifactName": "SarvKhoj-${version}-linux-${arch}.${ext}"
    }
  }
}